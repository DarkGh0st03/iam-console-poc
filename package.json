{
  "name": "iam-console-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "security"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c auto \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w @iam/backend",
    "dev:frontend": "npm run dev -w @iam/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run build -w @iam/frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
